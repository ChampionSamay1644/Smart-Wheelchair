# ============================================================
# Smart Wheelchair API - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to git - it contains secrets!
# ============================================================

# ============================================================
# FIREBASE CLIENT CONFIGURATION (Public - safe to expose)
# ============================================================
# Get these from Firebase Console → Project Settings → General
# Under "Your apps" → Web app → Config object

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================================
# FIREBASE ADMIN SDK (Secret - NEVER expose publicly)
# ============================================================
# Get these from Firebase Console → Project Settings → Service Accounts
# Click "Generate new private key" - downloads a JSON file
# Use values from that JSON file

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# IMPORTANT: Keep the quotes and \n characters for the private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here_with_actual_newlines_as_backslash_n\n-----END PRIVATE KEY-----\n"

# ============================================================
# KILLSWITCH CONTROL
# ============================================================
# Set to "true" (string) to disable all hardware communication
# Set to "false" (string) to allow normal operation
# This is checked on every upload request

KILLSWITCH_ENABLED=false

# ============================================================
# NOTES FOR VERCEL DEPLOYMENT
# ============================================================
# When deploying to Vercel:
# 1. Go to Project Settings → Environment Variables
# 2. Add each variable above (one by one)
# 3. For FIREBASE_PRIVATE_KEY:
#    - Keep the quotes
#    - The \n should be actual newline characters in Vercel
#    - Or use the raw JSON key as-is with escaped newlines
# 4. Make sure KILLSWITCH_ENABLED is exactly "false" (not False, FALSE, or 0)
# 5. Redeploy after adding all variables

# ============================================================
# QUICK REFERENCE
# ============================================================
# Local testing:  http://localhost:3000
# Test simulator: python3 simulator.py --url http://localhost:3000
# Deploy:         vercel
# Dashboard:      https://your-app.vercel.app
# Status check:   https://your-app.vercel.app/api/status

