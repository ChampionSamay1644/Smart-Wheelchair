rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: users can read their own document and update limited fields
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow users to update their own document fields
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Pair codes: owner can create, authenticated users can read; claiming should be done
    // by a server or via client transaction with checks. Rules below are conservative.
    match /pair_codes/{code} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow read: if request.auth != null;

      // Prevent clients from arbitrarily overwriting used flag; require owner to create and
      // claiming should be done via a transaction by an authenticated user.
      allow update: if false;
      allow delete: if false;
    }

    // Fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
